{
  "name": "wispcss",
  "version": "1.0.5",
  "publishConfig": {
    "access": "public"
  },
  "author": "ZIMEKO Development Team",
  "license": "MIT",
  "description": "WispCSS, A pure CSS component and utility library built on the Tailwind CSS v4 compiler. Fully documented with inline comments, AI-friendly. It provides styled HTML native elements and a comprehensive set of utility classes for UI layout, without requiring any JavaScript.",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.css",
    "./*": "./src/*.css",
    "./*.css": "./src/*.css",
    "./prefix": "./src-prefix/index.css",
    "./prefix/*": "./src-prefix/*.css",
    "./prefix/*.css": "./src-prefix/*.css"
  },
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "private": false,
  "workspaces": [],
  "files": [
    "examples",
    "dist",
    "package.json",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "skill.md",
    "script-gen-color.js",
    "script-prefix.js",
    "script-mini.js",
    "LICENSE"
  ],
  "devDependencies": {
    "lightningcss": "^1.32.0"
  },
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/index.css -o ./dist/wispcss.css --watch",
    "gen-color": "node script-gen-color.js",
    "prefix": "node script-prefix.js",
    "mini": "node script-mini.js",
    "pack": "node script-pack.js",
    "git": "node script-git.js",
    "push": "node script-push.js",
    "all": "npm run mini && npm publish  && (npm run push || true)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zimeko/wispcss"
  },
  "extraRepositories": [
    {
      "type": "git",
      "url": "https://gitee.com/zimeko/wispcss"
    }
  ],
  "keywords": [
    "tailwind",
    "css4",
    "html5",
    "css3"
  ],
  "bugs": {
    "url": "https://github.com/zimeko/wispcss/issues"
  },
  "homepage": "https://www.zimeko.com",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "simple-git": "^3.27.0",
    "tailwindcss": "^4.3.2"
  }
}